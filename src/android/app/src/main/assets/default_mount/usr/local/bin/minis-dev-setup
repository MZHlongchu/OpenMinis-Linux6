#!/bin/sh
# Install a developer toolchain into the Ubuntu PRoot guest.
# Packages persist on the rootfs; safe to re-run.
set -e
export DEBIAN_FRONTEND=noninteractive

echo "minis-dev-setup: Ubuntu glibc toolchain (bash, gcc, python, git, ffmpeg, jdk, gradle)"

if ! command -v apt-get >/dev/null 2>&1; then
  echo "minis-dev-setup: apt-get not found — is this the Minis Linux Ubuntu guest?" >&2
  exit 1
fi

apt-get update
apt-get install -y --no-install-recommends \
  bash bash-completion \
  build-essential gcc g++ make cmake pkg-config \
  python3 python3-pip python3-venv python3-dev \
  git git-lfs \
  ffmpeg \
  openjdk-21-jdk-headless \
  unzip curl wget ca-certificates \
  tar xz-utils zip \
  file \
  openssh-client \
  rsync \
  sqlite3 \
  gradle || apt-get install -y --no-install-recommends \
    bash build-essential python3 python3-pip git ffmpeg \
    openjdk-21-jdk-headless unzip curl wget ca-certificates

JAVA_HOME=""
for d in /usr/lib/jvm/java-21-openjdk-arm64 /usr/lib/jvm/java-17-openjdk-arm64 /usr/lib/jvm/default-java; do
  if [ -d "$d" ]; then JAVA_HOME=$d; break; fi
done
if [ -z "$JAVA_HOME" ]; then
  JAVA_HOME=$(ls -d /usr/lib/jvm/java-*-openjdk-arm64 2>/dev/null | head -1 || true)
fi

umask 022
cat > /etc/profile.d/minis-dev.sh <<EOF
# Generated by minis-dev-setup — sourced by login shells.
${JAVA_HOME:+export JAVA_HOME=$JAVA_HOME}
export ANDROID_HOME=/opt/android-sdk
export ANDROID_SDK_ROOT=/opt/android-sdk
export PATH="\$PATH:/opt/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/gradle/bin"
${JAVA_HOME:+export PATH="\$JAVA_HOME/bin:\$PATH"}
export SHELL=/bin/bash
export DEBIAN_FRONTEND=noninteractive
EOF

echo
echo "minis-dev-setup: done"
echo "  bash:    $(command -v bash 2>/dev/null || echo missing)"
echo "  gcc:     $(command -v gcc 2>/dev/null || echo missing)"
echo "  python3: $(command -v python3 2>/dev/null || echo missing)"
echo "  git:     $(command -v git 2>/dev/null || echo missing)"
echo "  ffmpeg:  $(command -v ffmpeg 2>/dev/null || echo missing)"
echo "  java:    $(command -v java 2>/dev/null || echo missing)"
echo "  gradle:  $(command -v gradle 2>/dev/null || echo missing)"
echo
echo "This guest is Ubuntu 24.04 arm64 glibc — aarch64 Linux binaries run natively."
echo "Google's Android cmdline-tools are still x86_64; run minis-android-sdk-setup."
echo "Re-open the shell (or: . /etc/profile.d/minis-dev.sh) to pick up PATH."
